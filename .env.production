# Public build-time config (NEXT_PUBLIC_* values are shipped to the browser anyway).
# Committed so CI and `npm run build` are reproducible without local secrets.
# Real secrets (e.g. VESTIGE_API_KEY) belong in .env.local / CI secrets, never here.
NEXT_PUBLIC_VIGISWAP_SITE_URL=https://vigiswap.com
NEXT_PUBLIC_VIGISWAP_BRAND=VigiSwap
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=75f8646ebfb758a301ba98594bc1fe6f
