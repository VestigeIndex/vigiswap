{
  "name": "@utxo/safesign",
  "version": "1.0.0",
  "description": "UTXO SafeSign — local-first transaction-security SDK with legacy Guard heuristics and the unified Security Core.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "type": "module",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./core": {
      "import": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
      "require": { "types": "./dist/core.d.cts", "default": "./dist/core.cjs" }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/core.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "crypto",
    "wallet",
    "safesign",
    "transaction-security",
    "phishing",
    "EIP-712",
    "Permit2",
    "ERC-20",
    "approval",
    "risk",
    "ethereum",
    "non-custodial"
  ],
  "homepage": "https://www.utxosuite.com/api-store#safesign",
  "repository": { "type": "git", "url": "https://github.com/VestigeIndex/utxosuite.com" },
  "author": "UTXO Suite",
  "license": "MIT",
  "sideEffects": false
}

